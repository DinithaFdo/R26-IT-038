# Application metadata
APP_NAME=MULTI-SCOPE Voice Classification API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
DEV_AUTH_BYPASS=false
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DOCS_ENABLED=true
OPENAPI_ENABLED=true
MODEL_HEALTH_ENABLED=true
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Upload and audio constraints
UPLOAD_DIR=uploads
# Outer ASGI/proxy request body cap. Keep slightly above MAX_UPLOAD_SIZE_MB to
# allow multipart overhead while rejecting substantially oversized requests.
MAX_REQUEST_BODY_MB=27
MAX_UPLOAD_SIZE_MB=25
ALLOWED_AUDIO_EXTENSIONS=wav,flac,mp3,m4a,aac,opus,ogg,webm
TARGET_SAMPLE_RATE=16000
MIN_AUDIO_DURATION_SECONDS=1.0
MAX_AUDIO_DURATION_SECONDS=180
MAX_AUDIO_CHANNELS=2
MAX_INPUT_SAMPLE_RATE=96000
MAX_DECODED_AUDIO_SIZE_MB=32
PREPROCESSING_VERSION=audio-preprocessing-v2
MODEL_WINDOW_DURATION_SECONDS=6.0
MODEL_WINDOW_OVERLAP_SECONDS=1.0
AUDIO_PADDING_POLICY=right_zero
AUDIO_TRIM_POLICY=none

# FFmpeg tools must be installed and available on PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT_SECONDS=30
FFPROBE_TIMEOUT_SECONDS=15

# MongoDB Atlas
# Keep real credentials only in a local .env file; never commit them.
MONGODB_URI=
MONGODB_DATABASE=multiscope
MONGODB_REQUIRED=true
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_RETRY_READS=true
MONGODB_RETRY_WRITES=true

# Clerk authentication
# The frontend will send: Authorization: Bearer <Clerk session token>
#
# CLERK_ISSUER and CLERK_JWKS_URL are REQUIRED for any authenticated request to
# succeed, in every environment -- leaving them blank does not disable auth, it
# makes every request fail with 401 authentication_failed, because the JWKS
# fetch itself is refused before any token is inspected. This is a common setup
# trap: the frontend can be fully signed in via Clerk while every backend call
# still 401s, because these two are unset.
#
# Both must point at the SAME Clerk instance as the frontend's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY. Find your instance host by base64-decoding
# the middle segment of that key (pk_test_<base64>) -- it decodes to something
# like "your-instance-name.clerk.accounts.dev$". Then:
#   CLERK_ISSUER=https://your-instance-name.clerk.accounts.dev
#   CLERK_JWKS_URL=https://your-instance-name.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=
CLERK_JWKS_URL=
# Leave blank unless a Clerk JWT template adds a custom `aud` claim -- a
# default session token (frontend calling getToken() with no template) does
# not carry one, and a non-empty value here would then reject every token.
CLERK_AUDIENCE=
# Leave blank in development. Required in production/research (enforced by the
# settings validator); default session tokens carry the exact frontend
# origin(s) in `azp`, e.g. https://app.example.com.
CLERK_AUTHORIZED_PARTIES=
CLERK_JWKS_CACHE_SECONDS=3600
CLERK_JWKS_MIN_REFRESH_INTERVAL_SECONDS=60
CLERK_JWKS_NEGATIVE_KID_CACHE_SECONDS=60

# API keys
# Use a long random value in production. This key is used for HMAC hashing of
# API keys before storage; changing it invalidates existing API keys.
API_KEY_HASH_SECRET=development-only-change-me

# Cloudinary private audio storage
# Keep real credentials only in a local .env file; never commit them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AUDIO_FOLDER=multiscope/audio
CLOUDINARY_STORAGE_ENABLED=true
# required: fail prediction if storage fails. optional: continue prediction when
# storage fails. disabled: local/test only, no playback or rerun from stored audio.
STORAGE_POLICY=required
# Passed to the Cloudinary SDK where supported.
CLOUDINARY_SDK_TIMEOUT_SECONDS=60
# Outer application timeout; an outer timeout is an ambiguous upload outcome
# because Python cannot forcibly stop the underlying SDK worker thread.
CLOUDINARY_UPLOAD_TIMEOUT_SECONDS=60

# Prediction job execution
# MVP execution runs inline behind a job-runner abstraction and moves blocking
# media/model work to a bounded process-local executor. Future migration:
# replace InlinePredictionJobRunner with a durable worker process.
PREDICTION_JOB_TIMEOUT_SECONDS=180
MAX_CONCURRENT_PREDICTIONS=2
PREDICTION_SHUTDOWN_TIMEOUT_SECONDS=30
MAX_QUEUED_PREDICTIONS=4
MAX_ACTIVE_PREDICTIONS_PER_PRINCIPAL=1

# In-process admission/rate limiting. Use edge/provider limits as the primary
# production control; these per-process limits provide a backend safety net.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=120
PREDICTION_RATE_LIMIT_PER_WINDOW=20
API_KEY_CREATION_RATE_LIMIT_PER_WINDOW=10

# Deprecated compatibility route
# POST /api/v1/voice/predict is disabled by default and is never available in
# production. When explicitly enabled for local development, it still requires
# authentication and uses the same prediction submission/job-runner pipeline as
# POST /api/v1/predictions.
ENABLE_LEGACY_ANONYMOUS_PREDICTION=false

# MCP adapter
# Small base64 payloads are intended only for short clips and test fixtures.
# Normal 3-minute audio should use a future secure upload handoff, not base64.
MCP_SMALL_PAYLOAD_MAX_BYTES=1048576

# Model mode can be "dummy", "real", or "disabled".
#   dummy    - deterministic placeholder, for developing the pipeline
#   real     - loads a trained checkpoint (requires the "models" extra: torch)
#   disabled - branch has no trained model; runs nothing, excluded from fusion
#
# CNN, AASIST-Light, SSL (XLS-R + Mamba), and Glottal are all trained today.
#
# SSL requires the "models" extra's transformers dependency and network
# access on first startup to fetch the frozen XLS-R backbone from Hugging
# Face Hub (cached under ~/.cache/huggingface afterwards). It is deliberately
# NOT listed in REQUIRED_MODEL_BRANCHES below, so it contributes to fusion
# when available without being able to fail an entire prediction if it
# errors, times out, or its checkpoint/backbone is unavailable.
#
# Glottal requires the "glottal" extra (scikit-learn, DisVoice,
# praat-parselmouth, librosa, soundfile -- see pyproject.toml). It is a real
# branch (a frozen logistic-regression pipeline over 20 selected
# DisVoice/parselmouth/spectral features -- see
# app/models/preprocessing/glottal_v1.py and
# app/models/real/glottal_inference.py) but is auxiliary evidence only: it is
# NOT listed in REQUIRED_MODEL_BRANCHES, and app/utils/fusion.py excludes it
# from the primary CNN+AASIST+SSL fusion decision unconditionally, even if it
# succeeds -- see FULL_SYSTEM_BRANCHES in that file.
CNN_MODEL_MODE=real
AASIST_MODEL_MODE=real
SSL_MODEL_MODE=real
GLOTTAL_MODEL_MODE=real

# Model integration runtime. Real model paths can stay empty while the
# corresponding mode is "dummy" or "disabled". Canonical names are preferred;
# legacy CNN_MODEL_PATH and SSL_MODEL_PATH are still accepted for compatibility.
# Paths are resolved relative to MODEL_ROOT_DIR and may not escape it.
MODEL_ROOT_DIR=../model_artifacts
MODEL_SUPPORTED_CHECKPOINT_EXTENSIONS=.pt,.pth,.ckpt,.onnx,.safetensors,.joblib
# CNN-V2: self-describing (sample rate, LFCC-40+delta+delta-delta feature
# contract, and bonafide=0/spoof=1 label map are embedded in the checkpoint
# and validated at load time -- see load_cnn_v2_checkpoint_strict).
CNN_MODEL_PATH=cnn/cnn_v2_lfcc_delta_aug_asvspoof2019_inference_best.pt
LFCC_CNN_TCN_MODEL_PATH=
AASIST_MODEL_PATH=aasist/aasist_light_v2_best.pt
# A self-describing artifact (xlsr_model_name/label_mapping/sample_rate/
# max_duration_seconds are embedded and cross-checked at load time) -- see
# the "Real model contract (SSL branch)" section below. Superseded
# checkpoints: models/xlsr_mamba_asvspoof2019_best.pt (ASVspoof2019-only) and
# ssl/ssl_xlsr_mamba_generalization_v2_best.pt (a later fine-tune of this one).
SSL_MODEL_PATH=ssl/ssl_asvspoof5_best.pt
SSL_SEQUENCE_MODEL_PATH=
# Frozen backbone fetched by name from Hugging Face Hub on first load.
SSL_XLSR_MODEL_NAME=facebook/wav2vec2-large-xlsr-53
GLOTTAL_MODEL_PATH=glottal/glottal_logreg_selected20_v1.joblib
# The exact 20 selected-feature names/order the pipeline above was fit on.
# The manifest is the source of truth -- see build_glottal_loader.
GLOTTAL_SELECTED_FEATURES_PATH=glottal/glottal_selected_features_v1.json
# The final research detector's frozen fusion method/threshold/primary-branch
# contract (CNN + AASIST + SSL, simple_average, threshold 0.5519237850482265).
# Resolved relative to MODEL_ROOT_DIR, same convention as the checkpoint
# paths above. Leave FUSION_METHOD/FUSION_DECISION_THRESHOLD below unset so
# there is nothing to conflict with this file -- see
# app/utils/fusion.py::load_fusion_contract.
FUSION_CONTRACT_PATH=fusion/final_detector_v1.json
# Options: cpu | cuda | mps | auto. "auto" prefers CUDA, then MPS, then CPU.
#
# CPU is the default deliberately. Both trained branches are small (23.6k and
# 300k parameters), so on Apple silicon the MPS kernel-launch overhead exceeds
# the compute: measured on an M-series machine, AASIST-Light took ~30 ms on CPU
# versus ~192 ms on MPS, and the CNN ~2.0 ms versus ~2.5 ms. Switch to "auto"
# only if you have CUDA, or after measuring your own hardware.
MODEL_DEVICE_POLICY=cpu
MODEL_DEFAULT_DEVICE=cpu
MODEL_ALLOW_CPU_FALLBACK=true
MODEL_PRECISION=float32
# "startup" loads each real checkpoint once during application startup so the
# first prediction does not pay the load cost.
MODEL_LOAD_STRATEGY=startup
MODEL_LOAD_TIMEOUT_SECONDS=30
MODEL_LOAD_RETRY_COUNT=0
MODEL_BRANCH_TIMEOUT_SECONDS=30
LFCC_CNN_TCN_TIMEOUT_SECONDS=
AASIST_TIMEOUT_SECONDS=
SSL_SEQUENCE_TIMEOUT_SECONDS=
GLOTTAL_TIMEOUT_SECONDS=
LFCC_CNN_TCN_DEVICE=
AASIST_DEVICE=
SSL_SEQUENCE_DEVICE=
GLOTTAL_DEVICE=
# Branches this deployment needs in order to serve predictions. Listing a
# disabled branch here makes readiness fail, so it tracks the current stage.
REQUIRED_MODEL_BRANCHES=lfcc_cnn_tcn,aasist

# ---------------------------------------------------------------------------
# Real model contract (CNN acoustic branch)
# ---------------------------------------------------------------------------
# The trained checkpoints shipped WITHOUT a training notebook, feature config,
# or recorded label map, and both networks accept any input shape -- a wrong
# front end yields confident, wrong answers rather than an error. Every value
# below is therefore an explicit declaration you can correct without a code
# change. Defaults were chosen to match the training-time input distribution
# recovered from the checkpoints' BatchNorm running statistics (zero mean,
# ~unit variance), which rules out raw dB log-mel and raw MFCC but does not
# identify the filterbank type or coefficient count.
# These defaults were selected by sweeping 72 feature configurations and
# scoring each on (a) whether the checkpoint discriminated at all across
# diverse probe signals and (b) how closely the resulting feature distribution
# matched the one recorded in the checkpoint's first BatchNorm. An
# lfcc/per_coefficient_zscore/40 configuration was fully degenerate --
# spoof=1.000000 for every input. log_mel/global_zscore/20 discriminated across
# every probe and matched the recovered distribution. Best-evidenced, NOT
# verified. Replace with your training values.
CNN_FEATURE_TYPE=log_mel
CNN_FEATURE_FILTERS=20
CNN_FEATURE_COEFFICIENTS=20
CNN_FEATURE_N_FFT=512
CNN_FEATURE_HOP_LENGTH=160
CNN_FEATURE_WIN_LENGTH=400
CNN_FEATURE_FMIN=0.0
CNN_FEATURE_FMAX=
CNN_FEATURE_INCLUDE_DELTAS=false
CNN_FEATURE_NORMALIZATION=global_zscore
CNN_FEATURE_MAX_FRAMES=400

# ---------------------------------------------------------------------------
# Real model contract (AASIST-Light branch)
# ---------------------------------------------------------------------------
# Raw waveform input. BatchNorm forensics show the training input was
# zero-mean and amplitude-normalised, not raw audio.
AASIST_TARGET_SAMPLES=64000
AASIST_WAVEFORM_NORMALIZATION=peak
AASIST_LENGTH_POLICY=center_crop_pad
AASIST_TARGET_RMS=0.05

# ---------------------------------------------------------------------------
# Real model contract (SSL branch: XLS-R + Mamba)
# ---------------------------------------------------------------------------
# The deployed Generalization V2 artifact is a trainable-head-only package:
# it does NOT embed preprocessing, a label map, or the backbone name/shape --
# those are declared configuration (see SSL_XLSR_MODEL_NAME above and
# DECLARED_* constants in app/models/real/ssl_sequence_inference.py), the
# same trust boundary CNN/AASIST already use for their reverse-engineered
# feature contracts. What IS unverified: mamba-ssm (the official CUDA kernel
# package the model was almost certainly trained with) cannot install on a
# non-CUDA target -- confirmed, its setup.py crashes probing torch.version.cuda
# when it is None. app/models/architectures/xlsr_mamba.py runs a
# pure-PyTorch reimplementation of the same published selective-scan
# algorithm instead. Mathematically the same recurrence, but not yet
# cross-checked on this runtime against the documented Generalization V2
# evaluation metrics -- see SSL_PREPROCESSING_VERIFIED/SSL_CLASS_MAPPING_VERIFIED
# below.
SSL_TARGET_SAMPLES=96000

# ---------------------------------------------------------------------------
# Class order -- WHICH LOGIT INDEX MEANS "spoof"
# ---------------------------------------------------------------------------
# bonafide_spoof => index 0 is bonafide, index 1 is spoof
# spoof_bonafide => index 0 is spoof,    index 1 is bonafide
# Both conventions are common in ASVspoof code. Getting this wrong INVERTS
# every prediction while looking entirely plausible. Confirm against the
# training label map before trusting any result.
#
# !! MEASURED EVIDENCE: the two checkpoints appear to use OPPOSITE conventions.
# Across 8 probe signals the branches agreed 1/8 of the time when configured
# with the same class order and 7/8 when configured opposite. So exactly one of
# the two values below is probably wrong -- but the measurement cannot say
# which, because it only shows the two models are inverted relative to each
# other, not which one matches reality. Both are left at the same value here
# rather than guessing. Resolve this from your training label map first; it is
# the single highest-impact correction in this file.
CNN_CLASS_ORDER=bonafide_spoof
AASIST_CLASS_ORDER=bonafide_spoof
# The xlsr_mamba_asvspoof2019_best.pt artifact documents its own
# label_mapping directly: {"bonafide": 0, "spoof": 1}.
SSL_CLASS_ORDER=bonafide_spoof

# ---------------------------------------------------------------------------
# Verification attestations
# ---------------------------------------------------------------------------
# Set to true ONLY after confirming, against the training pipeline, that the
# feature settings and class order above are correct. While any of these is
# false the branch still runs and returns real model output, but the result is
# marked unverified, fusion is not research eligible, and the app refuses to
# start in production/research. Both flags must be true for a branch to count.
CNN_PREPROCESSING_VERIFIED=false
CNN_CLASS_MAPPING_VERIFIED=false
AASIST_PREPROCESSING_VERIFIED=false
AASIST_CLASS_MAPPING_VERIFIED=false
# See "Real model contract (SSL branch)" above: set true only after
# re-running the documented ASVspoof2019 LA evaluation against this
# pure-PyTorch Mamba scan and confirming EER ~= 0.0568 on this runtime.
SSL_PREPROCESSING_VERIFIED=false
SSL_CLASS_MAPPING_VERIFIED=false
# Glottal's preprocessing and label mapping are both fully declared by
# model_artifacts/glottal/glottal_selected_features_v1.json and the
# extraction code itself (app/models/preprocessing/glottal_v1.py) -- there is
# no reverse-engineered guesswork here, unlike CNN/AASIST/SSL above. Still
# defaults to false pending an explicit operator sign-off; Glottal never
# gates the primary fusion result either way (it is auxiliary evidence, see
# GLOTTAL_MODEL_MODE above), but an unverified branch must not claim
# `research_result: true` in its own metadata.
GLOTTAL_PREPROCESSING_VERIFIED=false
GLOTTAL_CLASS_MAPPING_VERIFIED=false

# Score-level fusion. FUSION_METHOD and FUSION_DECISION_THRESHOLD are
# deliberately left UNSET here: when FUSION_CONTRACT_PATH resolves to a valid
# file (see above), it is the authoritative source for both (currently:
# simple_average, threshold 0.5519237850482265, over CNN+AASIST+SSL only --
# Glottal is auxiliary evidence and never contributes). Setting either
# variable below to a value that disagrees with the contract file fails
# startup rather than silently overriding the frozen research contract.
# FUSION_WEIGHT_* below still governs the (now unused-by-default)
# weighted_average method, kept for local experimentation outside the frozen
# contract (e.g. FUSION_CONTRACT_PATH= to disable it).
FUSION_MIN_SUCCESSFUL_BRANCHES=2
FUSION_WEIGHT_LFCC_CNN_TCN=0.25
FUSION_WEIGHT_AASIST=0.25
FUSION_WEIGHT_SSL_SEQUENCE=0.25
FUSION_WEIGHT_GLOTTAL=0.25
FUSION_CONFIG_VERSION=fusion-config-v1
FUSION_REQUIRED_BRANCHES=
FUSION_ALLOW_EQUAL_WEIGHT_FALLBACK=true



# Voice XAI is independently queued only after prediction persistence succeeds.
# Keep disabled until the mock XAI endpoints are intentionally enabled locally.
XAI_ENABLED=true
XAI_MODE=real
XAI_PIPELINE_VERSION=voice-xai-pipeline-v1
XAI_MAX_WORKERS=1
XAI_MAX_QUEUED_JOBS=8
XAI_JOB_TIMEOUT_SECONDS=120
XAI_ARTIFACT_RETENTION_SECONDS=604800
# Private filesystem location for JSON/PNG/NPZ XAI evidence. MongoDB stores
# only authenticated references and content hashes.
XAI_ARTIFACT_ROOT=private_xai_artifacts
# Temporal XAI always uses the real XLS-R attention path and this locked
# PartialSpoof calibration. XAI_MODE=mock affects the semantic component only.
XAI_TEMPORAL_THRESHOLD_CONFIG_PATH=app/voice_xai/temporal/calibrations/partialspoof_v1_2_dev_attention_threshold.json
XAI_TEMPORAL_GLOBAL_HOP_SECONDS=0.02
XAI_TEMPORAL_SMOOTHING_MS=80
XAI_TEMPORAL_MINIMUM_REGION_DURATION_SECONDS=0.04
XAI_TEMPORAL_MERGE_GAP_SECONDS=0.1
# Real semantic mode loads once at application startup and rejects the model,
# feature-order, threshold, and training-metadata artifacts if any hash or
# contract check fails. A SHAP background is optional for the supplied v4 model.
XAI_SEMANTIC_MODEL_PATH=app/voice_xai/semantic/artifacts/semantic_xgb_3_2_0.json
XAI_SEMANTIC_MANIFEST_PATH=app/voice_xai/semantic/manifests/xgboost-surrogate-v4-xgb-3-2-0.json
XAI_SEMANTIC_FEATURE_COLUMNS_PATH=app/voice_xai/semantic/artifacts/feature_columns_v4.json
XAI_SEMANTIC_THRESHOLD_PATH=app/voice_xai/semantic/artifacts/threshold_v4.json
XAI_SEMANTIC_TRAINING_METADATA_PATH=app/voice_xai/semantic/artifacts/training_metadata_v4_xgb_3_2_0_reexport.json
XAI_SEMANTIC_IMPUTER_PATH=app/voice_xai/semantic/artifacts/imputer_v4.joblib
XAI_SEMANTIC_SHAP_BACKGROUND_PATH=
# Opt-in capture of bounded real-model intermediate representations. Tensors
# are stored later as private XAI artifacts, never returned by predictions.
# Benchmark the enabled mode on your deployment hardware before using it in a
# real-time environment.
XAI_CAPTURE_ENABLED=true
XAI_CAPTURE_MAX_TOTAL_ELEMENTS=1000000
# Optional Alibaba Model Studio Qwen rendering of already validated XAI
# evidence. This never receives uploaded audio. Keep disabled until a
# workspace-specific Singapore (or other chosen region) endpoint is ready.
# Use an exact dated model ID before final deployment to pin its behaviour.
XAI_NARRATIVE_ENABLED=false
XAI_NARRATIVE_API_KEY=
XAI_NARRATIVE_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
XAI_NARRATIVE_MODEL=qwen3.7-flash
XAI_NARRATIVE_TIMEOUT_SECONDS=30
XAI_NARRATIVE_ENABLE_THINKING=true
XAI_NARRATIVE_THINKING_BUDGET=1024
XAI_NARRATIVE_SUMMARY_MAX_WORDS=200
XAI_NARRATIVE_DETAILED_MAX_WORDS=500
XAI_NARRATIVE_MAX_SEMANTIC_FEATURES=6
# Per-authenticated-user limits on explanation trigger/retry (independent of
# the generic per-path rate limiter above, which does not bound these routes
# effectively because the path includes prediction_id).
XAI_TRIGGER_RATE_LIMIT_REQUESTS=5
XAI_TRIGGER_RATE_LIMIT_WINDOW_SECONDS=60
XAI_RETRY_RATE_LIMIT_REQUESTS=5
XAI_RETRY_RATE_LIMIT_WINDOW_SECONDS=60

# How often the background maintenance task physically deletes artifact files
# whose retention window has passed (API access already stops earlier).
XAI_ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600
# How long a run must sit unchanged in queued/running/partial/blocked before
# a startup reconciliation pass treats it as stranded by a restart and marks
# it failed. Keep this comfortably above XAI_JOB_TIMEOUT_SECONDS.
XAI_STALE_RUN_RECOVERY_THRESHOLD_SECONDS=300


# Comma-separated development origins. Do not use "*" in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
