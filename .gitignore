# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# ==========================================
# Machine Learning Models, Weights & Data
# ==========================================
# Excludes heavy weights (PyTorch, HuggingFace, XGBoost, Qwen, DeBERTa)
*.pt
*.pth
*.bin
*.safetensors
*.pkl
*.onnx
*.h5
*.pb
*.ckpt
*.msgpack
*.tflite

# Exclude all nested models/artifacts but keep the folder structures intact
**/models/*
!**/models/.gitkeep
**/artifacts/*
!**/artifacts/.gitkeep
**/checkpoints/*
**/validation_data/*
!**/validation_data/.gitkeep

