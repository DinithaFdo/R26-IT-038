# Voice Backend API Base URL (e.g. FastAPI voice detection service)
NEXT_PUBLIC_VOICE_API_BASE_URL=http://127.0.0.1:8000

# Text Backend API Base URL (e.g. FastAPI text classification service)
NEXT_PUBLIC_TEXT_API_BASE_URL=http://127.0.0.1:8001

# Fallback / General Base URL (for backward compatibility)
NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_APP_NAME=MULTI-SCOPE
NEXT_PUBLIC_ENABLE_AUDIO_RECORDING=true
NEXT_PUBLIC_SYSTEM_STATUS_REFRESH_MS=30000
NEXT_PUBLIC_PREDICTION_STATUS_POLL_MS=2000
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=25
NEXT_PUBLIC_MIN_AUDIO_DURATION_SECONDS=1
# Must mirror the backend's MAX_AUDIO_DURATION_SECONDS (backend default: 180).
# Client-side validation is UX only; the backend remains authoritative and will
# reject longer audio regardless of what is configured here.
NEXT_PUBLIC_MAX_AUDIO_DURATION_SECONDS=180
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
